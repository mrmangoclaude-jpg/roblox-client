-- Enum and EnumItem behaviour that protected scripts probe (HumanoidRigType.R15, EnumType, FromValue, errors).
local out = {}
local function clean(text)
	text = string.gsub(text, "[%w_%.%-]+:%d+: ", "")
	text = string.gsub(text, "0x%x+", "0xADDR")
	return text
end
local function show(v)
	if type(v) == "string" then return string.format("%q", clean(v)) end
	if type(v) == "function" or type(v) == "thread" then return type(v) end
	local ok, text = pcall(tostring, v)
	return typeof(v) .. ":" .. (ok and clean(text) or "?")
end
local function T(label, f, ...)
	local r = table.pack(pcall(f, ...))
	local parts = {}
	for i = 1, r.n do parts[i] = show(r[i]) end
	table.insert(out, label .. " -> " .. table.concat(parts, " | "))
end
local rig = Enum.HumanoidRigType
T("typeof Enum", function() return typeof(Enum) end)
T("tostring Enum", function() return tostring(Enum) end)
T("typeof HumanoidRigType", function() return typeof(rig) end)
T("tostring HumanoidRigType", function() return tostring(rig) end)
T("typeof R15", function() return typeof(rig.R15) end)
T("tostring R15", function() return tostring(rig.R15) end)
T("R15.Name/Value", function() return rig.R15.Name, rig.R15.Value end)
T("R15.EnumType", function() return rig.R15.EnumType end)
T("R15.EnumType == rig", function() return rig.R15.EnumType == rig end)
T("rig.R15 == rig.R15", function() return rig.R15 == rig.R15 end)
T("rawequal R15", function() return rawequal(rig.R15, rig.R15) end)
T("rig.FromValue", function() return typeof(rig.FromValue) end)
T("rig.FromValue == rig.FromValue", function() return rig.FromValue == rig.FromValue end)
T("rig.FromValue == Enum.Material.FromValue", function() return rig.FromValue == Enum.Material.FromValue end)
T("FromValue(1)", function() return rig:FromValue(1) end)
T("FromValue(0)", function() return rig:FromValue(0) end)
T("FromValue(999)", function() return rig:FromValue(999) end)
T("FromValue('1')", function() return rig:FromValue("1") end)
T("FromValue('a')", function() return rig:FromValue("a") end)
T("FromValue(1.5)", function() return rig:FromValue(1.5) end)
T("FromValue(nil)", function() return rig:FromValue(nil) end)
T("FromValue()", function() return rig:FromValue() end)
T("FromValue no self", function() return rig.FromValue(1) end)
T("FromName('R6')", function() return rig:FromName("R6") end)
T("FromName('x')", function() return rig:FromName("x") end)
T("FromName(1)", function() return rig:FromName(1) end)
T("GetEnumItems count", function() return #rig:GetEnumItems() end)
T("GetEnumItems order", function() local t = {} for _, item in rig:GetEnumItems() do table.insert(t, item.Name .. "=" .. item.Value) end return table.concat(t, ",") end)
T("rig.Nope", function() return rig.Nope end)
T("rig.R15.Nope", function() return rig.R15.Nope end)
T("Enum.Nope", function() return Enum.Nope end)
T("Enum.HumanoidRigType set", function() Enum.HumanoidRigType = 1 end)
T("rig.R15 set", function() rig.R15 = 1 end)
T("R15.Value set", function() rig.R15.Value = 1 end)
T("R15 compare", function() return rig.R15 == rig.R6, rig.R15 == 1, rig.R15 == "R15" end)
T("R15 < R6", function() return rig.R15 < rig.R6 end)
T("R15 + 1", function() return rig.R15 + 1 end)
T("R15 .. ''", function() return rig.R15 .. "" end)
T("#R15", function() return #rig.R15 end)
T("EnumItem IsA", function() return rig.R15:IsA("EnumItem") end)
T("rig:IsA", function() return rig:IsA("Enum") end)
T("Material Plastic Value", function() return Enum.Material.Plastic.Value end)
T("Material:FromValue(256)", function() return Enum.Material:FromValue(256) end)
T("Enum.KeyCode.A.EnumType", function() return Enum.KeyCode.A.EnumType end)
T("Enum.KeyCode:FromValue(97)", function() return Enum.KeyCode:FromValue(97) end)
T("next(rig)", function() return next(rig) end)
T("pairs(rig) count", function() local n = 0 for _ in pairs(rig) do n += 1 end return n end)
T("getmetatable(rig)", function() return getmetatable(rig) end)
T("getmetatable(R15)", function() return getmetatable(rig.R15) end)
T("typeof(Enum.KeyCode.A.EnumType)", function() return typeof(Enum.KeyCode.A.EnumType) end)
return table.concat(out, "\n")
