-- Bad-argument behaviour of the scheduler functions. Protected scripts call them with wrong arguments on purpose and
-- compare the errors; a call that wrongly waits or succeeds changes everything after it.
local out = {}
local function T(label, f, ...)
	local started = os.clock()
	local r = table.pack(pcall(f, ...))
	local parts = {}
	for i = 1, r.n do
		local v = r[i]
		parts[i] = typeof(v) == "string" and string.format("%q", v) or (typeof(v) == "function" and "function" or (typeof(v) == "thread" and "thread" or tostring(v)))
	end
	local slow = os.clock() - started > 0.2 and " [waited]" or ""
	table.insert(out, label .. " -> " .. table.concat(parts, " | ") .. slow)
end
local noop = function() end
T("task.spawn()", task.spawn)
T("task.spawn(nil)", task.spawn, nil)
T("task.spawn(1)", task.spawn, 1)
T("task.spawn('x')", task.spawn, "x")
T("task.spawn({})", task.spawn, {})
T("task.spawn(true)", task.spawn, true)
T("task.spawn(noop)", function() return typeof(task.spawn(noop)) end)
T("task.spawn(thread)", function() return typeof(task.spawn(coroutine.create(noop))) end)
T("task.defer()", task.defer)
T("task.defer(nil)", task.defer, nil)
T("task.defer(1)", task.defer, 1)
T("task.defer({})", task.defer, {})
T("task.defer(noop)", function() return typeof(task.defer(noop)) end)
T("task.delay()", task.delay)
T("task.delay(nil)", task.delay, nil)
T("task.delay(1)", task.delay, 1)
T("task.delay(1, nil)", task.delay, 1, nil)
T("task.delay(1, 1)", task.delay, 1, 1)
T("task.delay('a', noop)", task.delay, "a", noop)
T("task.delay({}, noop)", task.delay, {}, noop)
T("task.delay(nil, noop)", function() return typeof(task.delay(nil, noop)) end)
T("task.delay('0', noop)", function() return typeof(task.delay("0", noop)) end)
T("task.delay(0, noop)", function() return typeof(task.delay(0, noop)) end)
T("task.delay(-1, noop)", function() return typeof(task.delay(-1, noop)) end)
T("task.cancel()", task.cancel)
T("task.cancel(nil)", task.cancel, nil)
T("task.cancel(1)", task.cancel, 1)
T("task.cancel({})", task.cancel, {})
T("task.cancel(noop)", task.cancel, noop)
T("task.cancel(thread)", function() return tostring(task.cancel(coroutine.create(noop))) end)
T("task.wait('a')", task.wait, "a")
T("task.wait({})", task.wait, {})
T("task.wait(true)", task.wait, true)
T("task.wait(noop)", task.wait, noop)
T("task.wait('0')", function() return typeof(task.wait("0")) end)
T("task.wait(nil)", function() return typeof(task.wait(nil)) end)
T("task.wait(0)", function() return typeof(task.wait(0)) end)
T("task.wait(-1)", function() return typeof(task.wait(-1)) end)
T("task.wait(0/0)", function() return typeof(task.wait(0/0)) end)
T("task.wait(1, 2)", function() return typeof(task.wait(0, 2)) end)
T("wait('a')", wait, "a")
T("wait({})", wait, {})
T("wait(nil)", function() return typeof(wait(nil)) end)
T("wait(0)", function() return typeof(wait(0)) end)
T("spawn()", spawn)
T("spawn(nil)", spawn, nil)
T("spawn(1)", spawn, 1)
T("spawn({})", spawn, {})
T("spawn(noop)", function() return typeof(spawn(noop)) end)
T("delay()", delay)
T("delay(nil)", delay, nil)
T("delay(1)", delay, 1)
T("delay(1, nil)", delay, 1, nil)
T("delay('a', noop)", delay, "a", noop)
T("delay(0, noop)", function() return typeof(delay(0, noop)) end)
T("tick type", function() return typeof(tick()) end)
T("time type", function() return typeof(time()) end)
T("elapsedTime type", function() return typeof(elapsedTime()) end)
T("os.clock type", function() return typeof(os.clock()) end)
return table.concat(out, "\n")
