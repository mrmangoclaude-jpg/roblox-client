-- Messages of ordinary runtime errors. Protected scripts provoke them on purpose and compare the text.
local out = {}
local function clean(text)
	text = string.gsub(text, "[%w_%.%-]+:%d+: ", "")
	text = string.gsub(text, "0x%x+", "0xADDR")
	return text
end
local function T(label, f)
	local ok, err = pcall(f)
	table.insert(out, label .. " -> " .. tostring(ok) .. " | " .. clean(tostring(err)))
end
