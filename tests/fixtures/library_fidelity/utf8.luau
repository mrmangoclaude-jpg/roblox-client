local out = {}
local function T(label, f, ...)
	local r = table.pack(pcall(f, ...))
	local parts = {}
	for i = 1, r.n do parts[i] = typeof(r[i]) == "string" and string.format("%q", r[i]) or tostring(r[i]) end
	table.insert(out, label .. " -> " .. table.concat(parts, " | "))
end
T("nfc()", utf8.nfcnormalize)
T("nfc(1)", utf8.nfcnormalize, 1)
T("nfc(nil)", utf8.nfcnormalize, nil)
T("nfc({})", utf8.nfcnormalize, {})
T("nfc('')", utf8.nfcnormalize, "")
T("nfc('e\u{301}') bytes", function() return #utf8.nfcnormalize("e\u{301}") end)
T("nfd('\u{e9}') bytes", function() return #utf8.nfdnormalize("\u{e9}") end)
T("nfc hangul", function() return utf8.nfcnormalize("\u{1112}\u{1161}\u{11ab}") == "\u{d55c}" end)
T("nfd hangul", function() return #utf8.nfdnormalize("\u{d55c}") end)
T("nfc bad utf8", utf8.nfcnormalize, "\xff")
T("nfd bad utf8", utf8.nfdnormalize, "a\xffb")
T("nfd()", utf8.nfdnormalize)
T("nfc(12)", utf8.nfcnormalize, 12)
T("nfc extra", utf8.nfcnormalize, "a", "b")
T("graphemes()", utf8.graphemes)
T("graphemes(1) type", function() return type(utf8.graphemes(1)) end)
T("graphemes type", function() return type(utf8.graphemes("abc")) end)
T("graphemes list", function() local t = {} for a, b in utf8.graphemes("ae\u{301}x") do table.insert(t, a .. "-" .. b) end return table.concat(t, ",") end)
T("graphemes bad", function() local t = {} for a, b in utf8.graphemes("a\xffb") do table.insert(t, a .. "-" .. b) end return table.concat(t, ",") end)
T("graphemes i,j", function() local t = {} for a, b in utf8.graphemes("abcdef", 2, 4) do table.insert(t, a .. "-" .. b) end return table.concat(t, ",") end)
T("graphemes crlf", function() local t = {} for a, b in utf8.graphemes("a\r\nb") do table.insert(t, a .. "-" .. b) end return table.concat(t, ",") end)
return table.concat(out, "\n")
