local out = {}
local function T(label, f, ...)
	local r = table.pack(pcall(f, ...))
	local parts = {}
	for i = 1, r.n do parts[i] = typeof(r[i]) == "string" and string.format("%q", r[i]) or tostring(r[i]) end
	table.insert(out, label .. " -> " .. table.concat(parts, " | "))
end
T("profilebegin()", debug.profilebegin)
T("profilebegin(1)", debug.profilebegin, 1)
T("profilebegin(true)", debug.profilebegin, true)
T("profilebegin({})", debug.profilebegin, {})
T("profilebegin('a')", debug.profilebegin, "a")
T("profileend()", debug.profileend)
T("profileend() again", debug.profileend)
T("setmemorycategory('a')", function() debug.setmemorycategory("a") end)
T("setmemorycategory('b') returns previous", debug.setmemorycategory, "b")
T("getmemorycategory", debug.getmemorycategory)
T("setmemorycategory(1)", debug.setmemorycategory, 1)
T("getmemorycategory number tag", debug.getmemorycategory)
T("setmemorycategory()", debug.setmemorycategory)
T("setmemorycategory(nil)", debug.setmemorycategory, nil)
T("resetmemorycategory", debug.resetmemorycategory)
T("getmemorycategory after reset", debug.getmemorycategory)
T("synchronize()", task.synchronize)
T("desynchronize()", task.desynchronize)
T("fromExisting()", Instance.fromExisting)
T("fromExisting(1)", Instance.fromExisting, 1)
T("fromExisting(nil)", Instance.fromExisting, nil)
T("fromExisting('Part')", Instance.fromExisting, "Part")
T("fromExisting(workspace)", Instance.fromExisting, workspace)
T("fromExisting(game)", Instance.fromExisting, game)
T("fromExisting(Players)", Instance.fromExisting, game:GetService("Players"))
local p = Instance.new("Part")
p.Name = "Orig"; p.Anchored = true; p.Size = Vector3.new(1, 2, 3)
p:SetAttribute("k", 5)
local child = Instance.new("Attachment") child.Name = "Kid" child.Parent = p
p:AddTag("tg")
local holder = Instance.new("Folder") p.Parent = holder
T("copy keeps properties, drops children and parent", function()
	local c = Instance.fromExisting(p)
	return c.Name .. "|" .. tostring(c.Anchored) .. "|" .. tostring(c.Size) .. "|" .. tostring(c:GetAttribute("k")) .. "|children=" .. #c:GetChildren() .. "|parent=" .. tostring(c.Parent) .. "|tag=" .. tostring(c:HasTag("tg")) .. "|same=" .. tostring(c == p)
end)
T("Archivable false still copies", function() p.Archivable = false local c = Instance.fromExisting(p) return tostring(c) .. tostring(p.Archivable) end)
T("Clone with Archivable false is nil", function() return tostring(p:Clone()) end)
T("extra args ignored", function() return Instance.fromExisting(p, "x").Name end)
T("script class", function() local s = Instance.new("Script") s.Name = "S" local c = Instance.fromExisting(s) return c.ClassName .. c.Name end)
T("debug.info on the new members", function()
	return debug.info(utf8.graphemes, "s") .. "," .. debug.info(utf8.nfcnormalize, "s") .. "," .. debug.info(debug.profilebegin, "s") .. "," .. debug.info(Instance.fromExisting, "s") .. "," .. debug.info(task.synchronize, "s")
end)
return table.concat(out, "\n")
