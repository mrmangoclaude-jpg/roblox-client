local out = {}
local function rec(name, fn)
    local ok, a = pcall(fn)
    out[#out+1] = name .. "\t" .. (ok and ("ok:" .. tostring(a)) or ("err:" .. tostring(a)))
end
rec("V2 extra", function() return Vector2.new(1,2,3) end)
rec("V2 str", function() return Vector2.new("1","2") end)
rec("V2 nil1", function() return Vector2.new(nil,1) end)
rec("V2 nan", function() local v = Vector2.new(0/0, 1); return tostring(v.X ~= v.X) end)
rec("V2 inf", function() return Vector2.new(math.huge, 1) end)
rec("V2 tbl", function() return Vector2.new({}) end)
rec("V2 bool", function() return Vector2.new(true) end)
rec("V2 one", function() return Vector2.new(5) end)
local cpn = Path2DControlPoint.new
rec("CP num", function() return cpn(5) end)
rec("CP nil", function() return cpn(nil) end)
rec("CP str", function() return cpn("x") end)
rec("CP 2nd bad", function() return cpn(UDim2.new(), 5) end)
rec("CP extra", function() return cpn(UDim2.new(), UDim2.new(), UDim2.new(), UDim2.new()) end)
local cp = cpn(UDim2.new(0.5,10,0.25,-4), UDim2.fromOffset(1,2), UDim2.fromScale(0.1,0.2))
rec("CP tostring", function() return tostring(cp) end)
rec("CP typeof", function() return typeof(cp) end)
rec("CP getmt", function() return tostring(getmetatable(cp)) end)
rec("CP bad member", function() return cp.Foo end)
rec("CP set", function() cp.Position = UDim2.new() end)
rec("CP eq", function() return tostring(cp == cpn(UDim2.new(0.5,10,0.25,-4), UDim2.fromOffset(1,2), UDim2.fromScale(0.1,0.2))) end)
local p = Instance.new("Path2D")
rec("P2D defaults", function() return table.concat({tostring(p.Visible), tostring(p.Thickness), tostring(p.ZIndex), tostring(p.Closed), tostring(p.Color3)}, ",") end)
rec("P2D max", function() return p:GetMaxControlPoints() end)
rec("P2D segcount empty", function() return p:GetSegmentCount() end)
rec("P2D len empty", function() return p:GetLength() end)
rec("P2D pos empty", function() return p:GetPositionOnCurve(0.5) end)
rec("P2D getcp 1", function() return p:GetControlPoint(1) end)
rec("P2D insert idx5", function() p:InsertControlPoint(5, cp) end)
rec("P2D insert idx0", function() p:InsertControlPoint(0, cp) end)
rec("P2D insert ok", function() p:InsertControlPoint(1, cp); return #p:GetControlPoints() end)
rec("P2D update bad", function() p:UpdateControlPoint(3, cp) end)
rec("P2D remove bad", function() p:RemoveControlPoint(3) end)
rec("P2D set {1}", function() p:SetControlPoints({1}) end)
rec("P2D set 5", function() p:SetControlPoints(5) end)
rec("P2D set none", function() p:SetControlPoints() end)
rec("P2D getcp 1.5", function() return p:GetControlPoint(1.5) end)
rec("P2D unparented len", function() p:SetControlPoints({cp, cpn(UDim2.fromOffset(10,10))}); return p:GetLength() end)
p:Destroy()
return table.concat(out, "\n")
