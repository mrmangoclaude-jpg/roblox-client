local out = {}
local function rec(name, fn)
    local ok, a = pcall(fn)
    out[#out+1] = name .. "\t" .. (ok and ("ok:" .. tostring(a)) or ("err:" .. tostring(a)))
end
local cpn = Path2DControlPoint.new
local U = UDim2.new(0.5, 10, 0.25, -4)
rec("CP args 0", function() return cpn() end)
rec("CP args 1", function() return cpn(U) end)
rec("CP args 2", function() return cpn(U, U) end)
rec("CP args 3", function() return cpn(U, U, U) end)
rec("CP args 4", function() return cpn(U, U, U, U) end)
rec("CP args 1 then nil", function() return cpn(U, nil, nil) end)
rec("CP args 3 nil mid", function() return cpn(U, nil, U) end)
local cp = cpn(U, UDim2.fromOffset(1,2), UDim2.fromScale(0.1,0.2))
rec("CP set then read", function() cp.Position = UDim2.new(); return tostring(cp.Position) end)
rec("CP set Foo", function() cp.Foo = 1 end)
rec("CP same obj eq", function() return tostring(cp == cp) end)
rec("UDim2 getmt", function() return tostring(getmetatable(UDim2.new())) end)
rec("V2 getmt", function() return tostring(getmetatable(Vector2.new())) end)
rec("V2 badstr", function() return Vector2.new("a") end)
rec("V2 nil", function() return Vector2.new(nil) end)
rec("UDim2 tostring", function() return tostring(UDim2.new(0.1, 3, 0.2, 4)) end)
local function try_parent(label, make)
    rec("parent " .. label, function()
        local p = Instance.new("Path2D")
        local par = make()
        if par then p.Parent = par end
        p:SetControlPoints({cpn(UDim2.fromOffset(0,0)), cpn(UDim2.fromOffset(10,10))})
        local n = #p:GetControlPoints()
        p:Destroy()
        return "set ok, n=" .. n
    end)
end
try_parent("nil", function() return nil end)
try_parent("Frame", function() return Instance.new("Frame") end)
try_parent("ScreenGui", function() return Instance.new("ScreenGui") end)
try_parent("Folder", function() return Instance.new("Folder") end)
try_parent("TextLabel", function() return Instance.new("TextLabel") end)
try_parent("ImageLabel", function() return Instance.new("ImageLabel") end)
local fr = Instance.new("Frame"); fr.Size = UDim2.fromOffset(100, 50)
local p = Instance.new("Path2D"); p.Parent = fr
rec("P2D empty bounding", function() local r = p:GetBoundingRect(); return tostring(r) end)
rec("P2D empty segs", function() return p:GetLength() end)
p:SetControlPoints({cpn(UDim2.fromOffset(0,0)), cpn(UDim2.fromOffset(100,0))})
rec("P2D getcp 1.5", function() return tostring(p:GetControlPoint(1.5)) end)
rec("P2D getcp 0", function() return tostring(p:GetControlPoint(0)) end)
rec("P2D getcp str", function() return tostring(p:GetControlPoint("a")) end)
rec("P2D pos nan", function() return tostring(p:GetPositionOnCurve(0/0)) end)
rec("P2D pos str", function() return tostring(p:GetPositionOnCurve("a")) end)
rec("P2D pos nil", function() return tostring(p:GetPositionOnCurve()) end)
rec("P2D pos 5", function() return tostring(p:GetPositionOnCurve(5)) end)
rec("P2D tan -1", function() return tostring(p:GetTangentOnCurve(-1)) end)
rec("P2D insert 1.5", function() p:InsertControlPoint(1.5, cpn(UDim2.fromOffset(5,5))); return #p:GetControlPoints() end)
rec("P2D insert badcp", function() p:InsertControlPoint(1, 5) end)
rec("P2D insert nocp", function() p:InsertControlPoint(1) end)
rec("P2D update str", function() p:UpdateControlPoint("a", cpn(UDim2.new())) end)
rec("P2D set nonCP tbl", function() p:SetControlPoints({cpn(UDim2.new()), "x"}) end)
rec("P2D set mixed holes", function() p:SetControlPoints({[1]=cpn(UDim2.new()), [3]=cpn(UDim2.new())}) end)
local many = {}
for i = 1, 101 do many[i] = cpn(UDim2.new()) end
rec("P2D set 101", function() p:SetControlPoints(many) end)
many[101] = nil
rec("P2D set 100", function() p:SetControlPoints(many); return #p:GetControlPoints() end)
rec("P2D insert at 100", function() p:InsertControlPoint(1, cpn(UDim2.new())) end)
rec("P2D segcount cap", function() return p:GetSegmentCount() end)
rec("P2D selected prop", function() return tostring(p.SelectedControlPoint) end)
rec("P2D selectedData", function() return tostring(p.SelectedControlPointData) end)
fr:Destroy()
return table.concat(out, "\n")
